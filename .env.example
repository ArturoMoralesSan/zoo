# Producción: APP_ENV=production, APP_DEBUG=false, APP_ZOODECK_DEV=0,
# APP_PAYMENTS_SIMULATED=0, SESSION_SECURE_COOKIE=true y TRUSTED_PROXIES con las IP
# del balanceador o proxy. Los valores de abajo son para desarrollo local.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Pestañas para revocar capturas y reiniciar intentos. Solo para probar.
APP_ZOODECK_DEV=0
APP_ZOODECK_ENFORCE_VALIDATIONS=0
APP_ZOODECK_LOCATION_TOLERANCE=30

# Aprueba compras y donaciones de la app sin cobrar (aún no hay pasarela).
# Si no se define, solo se enciende con APP_ENV=local.
APP_PAYMENTS_SIMULATED=1

# IP o rangos del proxy, separados por comas (o * detrás de un balanceador
# que no se puede saltar). Vacío = no se confía en ningún proxy.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Codificador WebP del servidor: auto (Imagick y luego GD), imagick, gd o none.
# Sin ninguno, el navegador comprime las imágenes antes de subirlas.
IMAGE_ENCODER=auto

# Paquetes sin conexión de las tarjetas (docs/offline-packs-backend.md).
# Sin CARD_PACK_SECRET, las llaves se derivan de APP_KEY. Si cambia cualquiera
# de los dos, corre `php artisan cards:packs:build --force`.
CARD_PACKS_ENABLED=true
CARD_PACK_SECRET=

# Monto mínimo (MXN) de una donación para dar los puntos de la regla `donation`.
POINTS_DONATION_MIN_AMOUNT=50
# 1 = reglas de puntos como antes: el panel no marca reglas "Sin uso" y la temporada
# anuncia todas las reglas que cambia. No cambia cómo se otorgan los puntos.
APP_POINTS_RULES_LEGACY=0

