includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Errores que ya existían (phpstan-baseline.neon). Solo fallan los nuevos.
    # Al arreglar uno, regenera el baseline: no es error que sobre una entrada.
    reportUnmatchedIgnoredErrors: false
